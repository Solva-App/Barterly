{
  "name": "Barterly — Swap what you have for what you need",
  "short_name": "Barterly",
  "description": "Peer-to-peer barter marketplace. Post, chat and swap with verified people in your state.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f6f7fb",
  "theme_color": "#be123c",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Post an item", "url": "./#/post", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "My chats", "url": "./#/chats", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
